dps:
    sw1:
        dp_id: 0x1
        hardware: "Open vSwitch"
        interfaces:
            1:
                native_vlan: backend_net
                description: "Docker Container 1"
                acls_in: [my_rules]
            2:
                native_vlan: backend_net
                description: "Docker Container 2"
                acls_in: [my_rules]

            3:
                native_vlan: backend_net
                description: "Docker Container 3"
                acls_in: [my_rules]
            4:
                native_vlan: backend_net
                description: "Client/Traffic Generator"
                acls_in: [my_rules]

vlans:
    backend_net:
        vid: 100
        description: "Network for containers"


acls:
    my_rules:
        - rule:
            nw_dst: "10.0.0.100"
            dl_type: 0x800
            actions:
                output:
                    port: 2
        - rule:
            actions:
                allow: 1
